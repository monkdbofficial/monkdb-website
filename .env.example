# Copy to .env.local and fill in. .env.local is gitignored.

# Google Analytics 4 measurement ID (format: G-XXXXXXXXXX).
# Find it in Google Analytics: Admin -> Data Streams -> Web -> Measurement ID.
# Leave blank to skip GA injection entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: Google Tag Manager container ID (format: GTM-XXXXXXX).
# Use this instead of GA4 if you load everything through GTM.
NEXT_PUBLIC_GTM_ID=

# Google Search Console verification token. Paste only the value, not the full
# <meta> tag. Find it in Search Console -> Settings -> Ownership verification
# -> HTML tag. Leave blank if you verify via DNS or a file upload instead.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ─── Contact form email (Resend) ─────────────────────────────────────────────
# /api/send uses Resend to deliver contact-form submissions.
# Get a key at https://resend.com (free tier: 100 emails/day).
# NOTE: rotate this if the previous key was ever committed to a public repo.
RESEND_API_KEY=

# Inbox that receives contact-form submissions.
CONTACT_TO_EMAIL=support@monkdb.com

# Verified sender on Resend. For testing use "MonkDB <onboarding@resend.dev>".
# For production use your verified domain, e.g. "MonkDB <hello@monkdb.com>".
CONTACT_FROM_EMAIL=MonkDB <onboarding@resend.dev>
